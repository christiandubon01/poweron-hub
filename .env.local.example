# ══════════════════════════════════════════════════════════════════════════════
# PowerOn Hub — Environment Variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — NEVER expose in frontend; only used in Edge Functions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Project ref — for Management API calls in Edge Functions
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# Found in: upstash.com → Console → Database → Details
# NOTE: Upstash uses HTTPS REST API, not a raw Redis URL
#
# SEC2: server-side ONLY — no VITE_ prefix. This is a full read/write REST
# credential; a VITE_-prefixed copy is inlined into the public bundle by Vite.
# Read only by netlify/functions/session-store.ts.
UPSTASH_REDIS_URL=https://your-database.upstash.io
UPSTASH_REDIS_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenAI (Whisper + embeddings — SERVER KEY FOR WHISPER) ────────────────────
# Browser must NEVER call OpenAI with a real key in production.
# VITE_OPENAI_API_KEY is forced undefined in the production Vite bundle; it may
# still exist in .env.local for legacy local fallbacks only.
VITE_OPENAI_API_KEY=sk-proj-...
#
# Whisper Netlify function (/.netlify/functions/whisper) reads:
#   POWERON_OPENAI_API_KEY  (preferred)
#   OPENAI_API_KEY          (production fallback)
#
# Same class as POWERON_ANTHROPIC_API_KEY: under `netlify dev`, Netlify's AI
# Gateway may inject its own OPENAI_API_KEY that is rejected by api.openai.com
# with 401 invalid_issuer. Put PowerOn's direct OpenAI secret in
# POWERON_OPENAI_API_KEY so Whisper never uses the gateway credential.
POWERON_OPENAI_API_KEY=
# Optional legacy alias for production sites that already set OPENAI_API_KEY.
# OPENAI_API_KEY=sk-proj-...

# ── Anthropic (agent reasoning — SERVER-SIDE ONLY) ────────────────────────────
# SERVER-SIDE ONLY. No VITE_ prefix — the Anthropic key NEVER reaches the
# browser bundle. Read only by netlify/functions/claude.ts (the Claude proxy),
# which calls https://api.anthropic.com/v1/messages directly.
#
# AI-KEY-1C: PowerOn's direct Anthropic credential lives in POWERON_ANTHROPIC_API_KEY,
# NOT ANTHROPIC_API_KEY. Under `netlify dev`, Netlify's AI Gateway provider
# environment injects its OWN ANTHROPIC_API_KEY (plus ANTHROPIC_BASE_URL pointing
# at /.netlify/ai), which collides with the legacy name and causes 401
# authentication_error against api.anthropic.com. The POWERON_ namespace isolates
# PowerOn's credential from the gateway. The proxy never uses ANTHROPIC_BASE_URL
# and has no fallback to ANTHROPIC_API_KEY.
#
# Set this in your Netlify environment (Site settings → Environment variables),
# and in this .env file for `netlify dev`. Browser AI features call the
# /.netlify/functions/claude proxy, which injects this key server-side.
POWERON_ANTHROPIC_API_KEY=sk-ant-api03-...

# NOTE on `npm run dev` (Vite-only, no `netlify dev`): the Vite configureServer
# dev proxy in vite.config.js still reads the legacy ANTHROPIC_API_KEY name.
# There is no Netlify AI Gateway in that path, so the collision does not occur.
# Keep ANTHROPIC_API_KEY set to the same value if you use `npm run dev`.
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Cloudflare R2 (nightly backups) ──────────────────────────────────────────
# Found in: Cloudflare Dashboard → R2 → API Tokens
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key-id
R2_SECRET_KEY=your-r2-secret-access-key
R2_BUCKET=poweron-backups

# ── Stripe (billing — Phase 08) ───────────────────────────────────────────────
# Set up now so the schema columns have values when needed
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── OneSignal (push notifications — Phase 02) ─────────────────────────────────
VITE_ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_API_KEY=your-onesignal-api-key

# ── Google APIs (Calendar sync — Phase 05) ────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
VITE_GOOGLE_CALENDAR_API_KEY=AIzaSy...

# ── ElevenLabs (voice — Phase 06) ────────────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ── QuickBooks Online (server-side OAuth — V3) ──────────────────────────────
# SERVER-SIDE ONLY. These are NEVER prefixed with VITE_ and never reach the
# browser bundle. Used by netlify/functions/quickbooks + src/services/quickbooks.
# Authorization: https://appcenter.intuit.com/connect/oauth2
# Token:         https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer
INTUIT_CLIENT_ID=your-intuit-client-id
INTUIT_CLIENT_SECRET=your-intuit-client-secret
# QBO-3A-RUN-2: the callback endpoint is the REGISTERED top-level Netlify
# function qbo-callback (which delegates to netlify/functions/quickbooks/qbo-callback.ts).
# Netlify does not route the nested path.
# Configure INTUIT_REDIRECT_URI in Netlify for the QuickBooks OAuth callback.
INTUIT_REDIRECT_URI=
# Dedicated OAuth state signing secret. REQUIRED in production (JWT_SECRET is a
# dev-only fallback and is never silently substituted in production).
INTUIT_OAUTH_STATE_SECRET=generate-a-long-random-secret
# QBO-3A: dedicated server-only AES-256-GCM key for encrypting QuickBooks OAuth
# tokens at rest (public.quickbooks_connections). Generate 32 random bytes and
# base64-encode them, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER prefix with VITE_ — this MUST NOT reach the browser bundle. Read only by
# netlify/functions/quickbooks. A wrong-length key is refused (never truncated).
POWERON_QBO_TOKEN_ENCRYPTION_KEY=base64-of-32-random-bytes
# QBO-3A: QuickBooks API environment. Authorize/token/revoke endpoints are shared
# across environments; this selects the accounting API base URL used for the
# CompanyInfo read (sandbox-quickbooks.api.intuit.com vs quickbooks.api.intuit.com)
# and is stored on each connection record so a sandbox credential is never
# accidentally treated as production. Use "sandbox" for the owner OAuth smoke
# test; switch to "production" for a real company. Defaults to production if unset.
INTUIT_API_ENV=sandbox

# ── App metadata ──────────────────────────────────────────────────────────────
VITE_APP_VERSION=0.1.0
VITE_APP_ENV=development
