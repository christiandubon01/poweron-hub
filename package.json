{
  "name": "poweron-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "agent-host:start": "node --experimental-strip-types agent-host/index.ts",
    "agent-host:status": "node --experimental-strip-types agent-host/status.ts",
    "agent-host:typecheck": "tsc -p agent-host/tsconfig.json",
    "agent-host:test": "node --experimental-strip-types --test agent-host/agent-host.test.ts agent-host/orchestration.test.ts agent-host/providers/providers.test.ts agent-host/providers/claude.test.ts agent-host/providers/codex.test.ts agent-host/providers/executor.test.ts",
    "app-brain:generate": "node scripts/generate-app-brain-manifest.mjs",
    "app-brain:refresh": "node scripts/app-brain-watch.mjs --once",
    "app-brain:watch": "node scripts/app-brain-watch.mjs --watch",
    "supabase:types": "supabase gen types typescript --local > src/lib/db/types.ts"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/android": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@picovoice/porcupine-web": "^3.0.3",
    "@picovoice/web-voice-processor": "^4.0.8",
    "@react-google-maps/api": "^2.20.8",
    "@supabase/supabase-js": "^2.43.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-biometric": "^2.3.2",
    "@upstash/redis": "^1.31.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "eruda": "^3.4.0",
    "howler": "^2.2.4",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.383.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7",
    "resend": "^6.12.2",
    "tailwind-merge": "^2.3.0",
    "three": "^0.176.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.183.1",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "happy-dom": "^17.4.4",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^2.1.9"
  }
}
